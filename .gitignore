# secrets
.env

# python
.venv/
__pycache__/
*.pyc

# CyberMetric dataset files: no LICENSE file upstream (github.com/cybermetric/CyberMetric),
# so redistribution rights are unclear. Fetch at run time instead of committing.
legacy/data/*.json

# per-question run logs (large, regenerated by every run) and raw stdout captures
legacy/results/*.jsonl
legacy/results/*.log
*.log

# reasoning-on run: finished 2026-09-18. Keep the summary, drop the raw
# per-question jsonl logs (same policy as results/).
legacy/results_reasoning_on/*.jsonl

# calibration: keep the reports, drop the raw append-only log
legacy/calibration/calibration.log

# Benchmark task files: fetched at run time by knowledge/download_data.sh (CTIBench is CC BY-NC-SA 4.0)
data/

# Hubble flow export: raw files are 2 GB each (16 GB total); only the summary
# (agentic/netlog/dns_verdicts.md) and the sandbox-DNS extract
# (agentic/netlog/sandbox_dns.jsonl.gz) are committed. Raw files stay on the run host.
agentic/netlog/events*.log
