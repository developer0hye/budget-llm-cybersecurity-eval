# secrets
.env

# python
.venv/
__pycache__/
*.pyc

# CyberMetric dataset files: no LICENSE file upstream (github.com/cybermetric/CyberMetric),
# so redistribution rights are unclear. Fetch at run time instead of committing.
data/*.json

# per-question run logs (large, regenerated by every run) and raw stdout captures
results/*.jsonl
results/*.log
*.log

# reasoning-on run: finished 2026-09-18. Keep the summary, drop the raw
# per-question jsonl logs (same policy as results/).
results_reasoning_on/*.jsonl

# calibration: keep the reports, drop the raw append-only log
calibration/calibration.log
