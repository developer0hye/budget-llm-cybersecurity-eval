.env

# python
.venv/
__pycache__/
*.pyc

# CyberMetric dataset files: no LICENSE file upstream (github.com/cybermetric/CyberMetric),
# so redistribution rights are unclear. Fetch at run time instead of committing.
data/*.json

# per-question run logs (large, regenerated by every run) and raw stdout captures
results/*.jsonl
results/*.log
*.log

# reasoning-on run: still in progress as of the initial commit, incomplete/
# partial data. Un-ignore (or copy summary.json in explicitly) once
# results_reasoning_on/summary.json reflects a finished 2000-question run.
results_reasoning_on/
